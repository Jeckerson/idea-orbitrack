<idea-plugin>
    <id>dev.anvas.orbitrack.idea</id>
    <name>OrbiTrack</name>
    <vendor url="https://anvas.dev">Anton</vendor>
    <description><![CDATA[
        Aggregate GitHub issues and PRs across orgs and repos into a single IDE interface
        with inline comment CRUD and LLM context extraction.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window -->
        <toolWindow id="OrbiTrack"
                    anchor="right"
                    factoryClass="dev.anvas.orbitrack.idea.ui.OrbiTrackToolWindowFactory"
                    icon="/icons/orbitrack.svg"/>

        <!-- Application-level service (token, global org config) -->
        <applicationService
            serviceImplementation="dev.anvas.orbitrack.idea.services.OrbiTrackAppService"/>

        <!-- Project-level service (tracked repos, sync state) -->
        <projectService
            serviceImplementation="dev.anvas.orbitrack.idea.services.OrbiTrackProjectService"/>

        <!-- Settings page -->
        <applicationConfigurable
            parentId="tools"
            instance="dev.anvas.orbitrack.idea.settings.OrbiTrackConfigurable"
            displayName="OrbiTrack"/>
    </extensions>

    <actions>
        <action id="OrbiTrack.Refresh"
                class="dev.anvas.orbitrack.idea.actions.RefreshAction"
                text="Refresh"
                icon="AllIcons.Actions.Refresh"/>
        <action id="OrbiTrack.CreateIssue"
                class="dev.anvas.orbitrack.idea.actions.CreateIssueAction"
                text="New Issue"
                description="Create a new GitHub issue"
                icon="AllIcons.General.Add"/>
    </actions>
</idea-plugin>

